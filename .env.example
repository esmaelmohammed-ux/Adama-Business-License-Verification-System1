# Copy to .env and fill in before: docker compose up -d --build

# MySQL (used by docker-compose db service)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=ketelelema_audit
MYSQL_USER=ketelelema
MYSQL_PASSWORD=change_me_db_password

# App
APP_PORT=5000
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Public URL where users open the app (used for CORS)
CORS_ORIGIN=http://localhost:5000
